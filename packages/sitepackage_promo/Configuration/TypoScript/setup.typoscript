# Everything structural (config, meta wiring, content rendering, PAGE
# object, Fluid paths) lives in sitepackage_base. This package only adds
# the brand stylesheet (custom property values + self-hosted @font-face
# declarations) on top of it.
page.includeCSS {
    fonts = EXT:sitepackage_promo/Resources/Public/Css/fonts.css
    brand = EXT:sitepackage_promo/Resources/Public/Css/brand.css
}
