page = PAGE
page {
    typeNum = 0

    includeCSS {
        base = EXT:sitepackage_base/Resources/Public/Css/base.css
    }

    # Person/ProfessionalService JSON-LD, injected into <head> by PageRenderer.
    # Plain TypoScript TEXT (not Fluid): these are site-wide constants, and
    # Fluid's own "{...}" expression syntax collides with raw JSON braces.
    headerData {
        10 = TEXT
        10 {
            value (
<script type="application/ld+json">
{
    "@context": "https://schema.org",
    "@graph": [
        {
            "@type": "{$sitepackage.schemaPersonType}",
            "@id": "{$sitepackage.siteUrl}#person",
            "name": "{$sitepackage.siteName}",
            "jobTitle": "{$sitepackage.siteTagline}",
            "url": "{$sitepackage.siteUrl}",
            "email": "mailto:{$sitepackage.contactEmail}"
        },
        {
            "@type": "ProfessionalService",
            "@id": "{$sitepackage.siteUrl}#service",
            "name": "{$sitepackage.siteName}",
            "url": "{$sitepackage.siteUrl}",
            "founder": {"@id": "{$sitepackage.siteUrl}#person"},
            "areaServed": "Worldwide"
        }
    ]
}
</script>
            )
        }
    }

    bodyTagCObject = TEXT
    bodyTagCObject {
        wrap = <body id="page-|">
        current = 1
    }

    10 = FLUIDTEMPLATE
    10 {
        templateName = Default
        templateRootPaths {
            0 = EXT:sitepackage_base/Resources/Private/Templates/Page/
        }
        partialRootPaths {
            0 = EXT:sitepackage_base/Resources/Private/Partials/
        }
        layoutRootPaths {
            0 = EXT:sitepackage_base/Resources/Private/Layouts/
        }

        dataProcessing {
            # Top-level pages under the site root, used for the main navigation.
            10 = TYPO3\CMS\Frontend\DataProcessing\MenuProcessor
            10 {
                special = directory
                special.value.data = leveluid:0
                levels = 1
                expandAll = 1
                includeSpacer = 1
                titleField = nav_title // title
                as = mainnavigation
            }

            # A "directory" menu lists a page's children, never the page
            # itself — so the site root (Home) can't appear in `mainnavigation`
            # above. This second, single-item menu supplies it generically
            # (root's own nav_title/nav_hide/active-state), no hardcoded uid.
            20 = TYPO3\CMS\Frontend\DataProcessing\MenuProcessor
            20 {
                special = list
                special.value.data = leveluid:0
                titleField = nav_title // title
                as = homenavigation
            }

            # Alternate-language links for the header's language toggle —
            # each item carries its own translated `link` to the current
            # page, so switching language never drops the visitor back to
            # the homepage.
            30 = TYPO3\CMS\Frontend\DataProcessing\LanguageMenuProcessor
            30 {
                as = languagemenu
            }
        }

        variables {
            siteName = TEXT
            siteName.value = {$sitepackage.siteName}

            brandmark = TEXT
            brandmark.value = {$sitepackage.brandmark}

            siteTagline = TEXT
            siteTagline.value = {$sitepackage.siteTagline}

            siteUrl = TEXT
            siteUrl.value = {$sitepackage.siteUrl}

            contactEmail = TEXT
            contactEmail.value = {$sitepackage.contactEmail}

            logoPath = TEXT
            logoPath.value = {$sitepackage.logoPath}
        }
    }
}
