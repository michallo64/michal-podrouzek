# b13/container grid presets — see Configuration/TCA/Overrides/tt_content.php
# for the corresponding CType/colPos registration.
tt_content.sitepackage-1col < lib.contentElement
tt_content.sitepackage-1col {
    templateName = OneColumn
    templateRootPaths {
        10 = EXT:sitepackage_base/Resources/Private/Templates/Container/
    }
    dataProcessing {
        100 = B13\Container\DataProcessing\ContainerProcessor
    }
}

